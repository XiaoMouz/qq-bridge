<Window x:Class="BetterChat.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:BetterChat" Title="BetterChat">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.Resources>
   <!-- 只为让 XAML 编译器生成 ClickableSettingsCard 的类型信息；没有它，代码里创建的卡片会被当成 ButtonBase，
        套 SettingsCard 样式时崩溃（2026-10-17 实测）。模板本身不会被使用。 -->
   <DataTemplate x:Key="ClickableSettingsCardTypeInfo"><local:ClickableSettingsCard/></DataTemplate>
   <DataTemplate x:Key="FaceTemplate" x:DataType="local:FaceEntry">
    <Grid Width="44" Height="44" ToolTipService.ToolTip="{x:Bind Name}" AutomationProperties.Name="{x:Bind Name}">
     <Image Source="{x:Bind ImagePath}" Width="30" Height="30" Stretch="Uniform"/>
    </Grid>
   </DataTemplate>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="Workspace" Grid.Row="1" Visibility="Collapsed">
  <!-- 外壳：Fluent 的左侧紧凑导航。返回键和展开导航的按钮都放在 TitleBar 上，NavigationView 自己的隐藏。 -->
  <NavigationView x:Name="Nav" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
   IsSettingsVisible="False" IsTitleBarAutoPaddingEnabled="False" OpenPaneLength="240" SelectionChanged="NavChanged"
   PaneOpening="NavPaneOpening" PaneClosing="NavPaneClosing" AutomationProperties.Name="主导航">
   <NavigationView.MenuItems>
    <NavigationViewItem x:Name="MessagesNavItem" Tag="messages" Content="消息" ToolTipService.ToolTip="消息">
     <NavigationViewItem.Icon><FontIcon Glyph="&#xE8BD;"/></NavigationViewItem.Icon>
     <NavigationViewItem.InfoBadge><InfoBadge x:Name="UnreadBadge" Visibility="Collapsed"/></NavigationViewItem.InfoBadge>
    </NavigationViewItem>
    <NavigationViewItem x:Name="ContactsNavItem" Tag="contacts" Content="联系人" ToolTipService.ToolTip="联系人">
     <NavigationViewItem.Icon><FontIcon Glyph="&#xE716;"/></NavigationViewItem.Icon>
    </NavigationViewItem>
   </NavigationView.MenuItems>
   <NavigationView.PaneFooter>
    <!-- 账号头像不是导航目的地，点了直接进「设置 → 连接与账号」。紧凑时宽 40 加左边距 4，和 48 宽的紧凑栏图标对齐；展开导航时显示昵称。 -->
    <Button x:Name="AccountButton" Visibility="Collapsed" Click="AccountClicked" MinWidth="40" Height="40" Margin="4,0,4,4" Padding="6,0"
     HorizontalAlignment="Left" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" AutomationProperties.Name="当前账号">
     <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceM}">
      <PersonPicture x:Name="AccountAvatar" Width="28" Height="28"/>
      <TextBlock x:Name="AccountName" Text="{x:Bind AccountAvatar.DisplayName, Mode=OneWay}" Visibility="Collapsed" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
     </StackPanel>
    </Button>
   </NavigationView.PaneFooter>
   <NavigationView.FooterMenuItems>
    <NavigationViewItem x:Name="SettingsNavItem" Tag="settings" Content="设置" ToolTipService.ToolTip="设置">
     <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon>
    </NavigationViewItem>
   </NavigationView.FooterMenuItems>
  <Grid x:Name="PaneHost">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="320" MinWidth="{StaticResource ListPaneMinWidth}" MaxWidth="{StaticResource ListPaneMaxWidth}"/><ColumnDefinition x:Name="DetailColumn" Width="*"/></Grid.ColumnDefinitions>
   <Grid x:Name="ListPane" Padding="{StaticResource ListPanePadding}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <!-- 正在同步只在标题下写一行小字（同 iOS 消息页副标题），不占一整条横幅。 -->
    <StackPanel Margin="8,0,0,8">
     <TextBlock x:Name="SectionTitle" Text="消息" Style="{StaticResource PageTitleTextBlockStyle}"/>
     <StackPanel x:Name="SyncCaption" Orientation="Horizontal" Spacing="{StaticResource SpaceS}" Visibility="Collapsed" Margin="1,2,0,0">
      <ProgressRing x:Name="SyncRing" IsActive="False" Width="12" Height="12" MinWidth="12" MinHeight="12"/>
      <TextBlock Text="正在同步…" Style="{StaticResource SecondaryCaptionTextBlockStyle}" VerticalAlignment="Center"/>
     </StackPanel>
    </StackPanel>
    <StackPanel Grid.Row="1">
     <SelectorBar x:Name="Filter" SelectionChanged="FilterChanged" Margin="0,0,0,8" AutomationProperties.Name="列表筛选"/>
     <!-- 只留需要用户处理的：连不上服务器、要重新登录、QQ 掉线（可直接去扫码）。 -->
     <InfoBar x:Name="ConnectionBanner" IsOpen="False" IsClosable="False" Severity="Warning" Margin="0,0,0,8" AutomationProperties.Name="连接提示">
      <InfoBar.ActionButton><Button x:Name="QqLoginAction" Content="扫码登录" Click="QqLoginActionClicked"/></InfoBar.ActionButton>
     </InfoBar>
    </StackPanel>
    <ListView x:Name="Items" Grid.Row="2" SelectionChanged="ItemSelected" IsItemClickEnabled="False" SelectionMode="Single" HorizontalContentAlignment="Stretch" AutomationProperties.Name="项目列表">
     <ListView.ItemTemplate><DataTemplate x:DataType="local:ListEntry">
      <!-- 会话行和 iOS DialogRow 对齐：头像｜名称 + 置顶 / 免打扰 + 时间｜[草稿] 发送者：预览 + @ / 回复 / 全体 + 未读数。 -->
      <Grid Padding="0,10" ColumnSpacing="{StaticResource SpaceM}" Background="Transparent" ContextRequested="ListRowContextRequested" AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
       <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <PersonPicture DisplayName="{x:Bind Title, Mode=OneWay}" Width="40" Height="40" Visibility="{x:Bind HasAvatar, Mode=OneWay}" Loaded="AvatarLoaded" Unloaded="AvatarUnloaded" DataContextChanged="AvatarContextChanged"/>
       <Border Width="40" Height="40" CornerRadius="{ThemeResource OverlayCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="{x:Bind HasGlyph, Mode=OneWay}">
        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="18"/>
       </Border>
       <Grid Grid.Column="1" RowSpacing="2" VerticalAlignment="Center">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpaceXS}" Margin="8,0,0,0" VerticalAlignment="Center">
         <FontIcon Glyph="&#xE718;" Style="{StaticResource RowStateIconStyle}" Visibility="{x:Bind Pinned, Mode=OneWay}" ToolTipService.ToolTip="已置顶"/>
         <FontIcon Glyph="&#xE7ED;" Style="{StaticResource RowStateIconStyle}" Visibility="{x:Bind Muted, Mode=OneWay}" ToolTipService.ToolTip="免打扰"/>
         <TextBlock Text="{x:Bind Caption, Mode=OneWay}" Style="{StaticResource SecondaryCaptionTextBlockStyle}"/>
        </StackPanel>
        <TextBlock Grid.Row="1" Style="{StaticResource SecondaryCaptionTextBlockStyle}" TextWrapping="NoWrap" Visibility="{x:Bind HasSubtitle, Mode=OneWay}">
         <Run Text="{x:Bind DraftPrefix, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/><Run Text="{x:Bind SenderPrefix, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/><Run Text="{x:Bind Subtitle, Mode=OneWay}"/>
        </TextBlock>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpaceXS}" Margin="8,0,0,0">
         <Border Style="{StaticResource RowMarkStyle}" Background="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind Mention, Mode=OneWay}" ToolTipService.ToolTip="有人@我"><TextBlock Text="@" Style="{StaticResource RowMarkTextStyle}"/></Border>
         <Border Style="{StaticResource RowMarkStyle}" Background="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind Reply, Mode=OneWay}" ToolTipService.ToolTip="有人回复我"><FontIcon Glyph="&#xE97A;" FontSize="9" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/></Border>
         <Border Style="{StaticResource RowMarkStyle}" Background="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind MentionAll, Mode=OneWay}" ToolTipService.ToolTip="@全体成员"><TextBlock Text="全" Style="{StaticResource RowMarkTextStyle}"/></Border>
         <Border Style="{StaticResource UnreadPillStyle}" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind AccentUnread, Mode=OneWay}"><TextBlock Text="{x:Bind Unread, Mode=OneWay}" Style="{StaticResource RowMarkTextStyle}"/></Border>
         <Border Style="{StaticResource UnreadPillStyle}" Background="{ThemeResource ControlStrongFillColorDefaultBrush}" Visibility="{x:Bind MutedUnread, Mode=OneWay}"><TextBlock Text="{x:Bind Unread, Mode=OneWay}" Style="{StaticResource RowMarkTextStyle}"/></Border>
        </StackPanel>
       </Grid>
      </Grid>
     </DataTemplate></ListView.ItemTemplate>
    </ListView>
    <Button x:Name="MoreSearchResults" Grid.Row="3" Content="加载更多搜索结果" Visibility="Collapsed" HorizontalAlignment="Stretch" Margin="4,8" Click="LoadSearchMore"/>
   </Grid>
   <!-- 拖动调整列表宽度；双击恢复默认。压在列表右边线上，左右各露 4 像素。 -->
   <local:PaneSplitter x:Name="ListSplitter" HorizontalAlignment="Right" Width="8" Margin="0,0,-4,0" Canvas.ZIndex="1"
    ManipulationMode="TranslateX" ManipulationDelta="ListSplitterDelta" ManipulationCompleted="ListSplitterCompleted" DoubleTapped="ListSplitterReset"
    ToolTipService.ToolTip="拖动调整列表宽度，双击恢复默认" AutomationProperties.Name="调整列表宽度"/>
   <Grid x:Name="DetailPane" Grid.Column="1" Margin="{StaticResource DetailCardMargin}" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="{ThemeResource OverlayCornerRadius}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Padding="{StaticResource PageHeaderPadding}" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock x:Name="ContentTitle" Text="欢迎使用 BetterChat" Style="{StaticResource PageTitleTextBlockStyle}"/><TextBlock x:Name="ContentSubtitle" Text="你的 QQ 消息，在 Windows 上保持同步" Style="{StaticResource SecondaryCaptionTextBlockStyle}"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
     <Button x:Name="ChatSearchButton" Content="&#xE721;" Style="{StaticResource IconButtonStyle}" Visibility="Collapsed" Click="ToggleChatSearch" ToolTipService.ToolTip="在会话中查找（Ctrl+F）" AutomationProperties.Name="在会话中查找"/>
     <Button x:Name="ChatMore" Content="&#xE712;" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center" Visibility="Collapsed" ToolTipService.ToolTip="会话选项" AutomationProperties.Name="会话选项" Click="ChatOptions"/>
     </StackPanel>
    </Grid>
    <Grid Grid.Row="1">
     <!-- 内容靠左、最宽 800：星号列加 MaxWidth（StackPanel 直接设 MaxWidth 会被居中，设 Left 又只按内容宽度排，卡片会挤窄，2026-10-17 实测）。 -->
     <ScrollViewer x:Name="DetailScroll" Padding="{StaticResource PagePadding}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="{StaticResource DetailContentMaxWidth}"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel x:Name="Details" Spacing="{StaticResource SpaceS}"/>
      </Grid>
     </ScrollViewer>
     <Grid x:Name="ChatPanel" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <!-- 会话内查找：标题栏放大镜或 Ctrl+F 打开，回车在中栏列出结果，Esc 关闭。 -->
      <AutoSuggestBox x:Name="ChatSearchBox" Visibility="Collapsed" Margin="20,8,20,0" PlaceholderText="在这个会话中查找" QueryIcon="Find"
       QuerySubmitted="ChatSearchSubmitted" KeyDown="ChatSearchKeyDown" AutomationProperties.Name="在会话中查找"/>
      <!-- 滚到顶部 / 底部附近自动加载上一页 / 下一页，加载时只显示一条细进度条。 -->
      <ProgressBar x:Name="HistoryLoadingBar" Grid.Row="1" IsIndeterminate="True" Visibility="Collapsed" Margin="20,4,20,0"/>
      <InfoBar x:Name="ChatLoadNotice" Grid.Row="2" Severity="Warning" IsClosable="True" Margin="20,0,20,8">
       <InfoBar.ActionButton><Button Content="重试" Click="RetryChatLoad"/></InfoBar.ActionButton>
      </InfoBar>
      <ListView x:Name="Messages" Grid.Row="3" SelectionChanged="MessageSelectionChanged" SelectionMode="None" HorizontalContentAlignment="Stretch" Padding="20,10" AutomationProperties.Name="聊天消息" ContainerContentChanging="MessageContainerChanging">
       <ListView.ItemTemplate><DataTemplate x:DataType="local:TimelineEntry"><ContentControl HorizontalContentAlignment="Stretch" IsTabStop="False" SizeChanged="MessageSizeChanged"/></DataTemplate></ListView.ItemTemplate>
       <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView"/></ItemsPanelTemplate></ListView.ItemsPanel>
      </ListView>
      <StackPanel x:Name="ChatState" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Spacing="12" Margin="24" Visibility="Collapsed">
       <ProgressRing x:Name="ChatLoading" Width="32" Height="32" IsActive="False"/>
       <TextBlock x:Name="ChatStateTitle" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       <TextBlock x:Name="ChatStateDescription" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <Button x:Name="ChatRetry" Content="重新加载" Click="RetryChatLoad" HorizontalAlignment="Center"/>
      </StackPanel>
      <!-- 浮动按钮：右下角，「@」在上、「回到最新」在下。 -->
      <StackPanel Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,16" Spacing="{StaticResource SpaceS}">
       <Grid>
        <Button x:Name="MentionJumpButton" Style="{StaticResource FloatingButtonStyle}" Visibility="Collapsed" Click="MentionJumpClicked"
         ToolTipService.ToolTip="有人@我或回复我" AutomationProperties.Name="查看 @我 和回复我的消息">
         <TextBlock Text="@" FontWeight="SemiBold" FontSize="16"/>
        </Button>
        <InfoBadge x:Name="MentionJumpBadge" Style="{ThemeResource CriticalValueInfoBadgeStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
         Visibility="{x:Bind MentionJumpButton.Visibility, Mode=OneWay}" IsHitTestVisible="False"/>
       </Grid>
       <Button x:Name="LatestButton" Style="{StaticResource FloatingButtonStyle}" Visibility="Collapsed" Click="ReturnToLatest"
        ToolTipService.ToolTip="回到最新" AutomationProperties.Name="回到最新">
        <FontIcon Glyph="&#xE74B;" FontSize="16"/>
       </Button>
      </StackPanel>
     </Grid>
    </Grid>
    <StackPanel x:Name="ComposerPanel" Grid.Row="2" Visibility="Collapsed" Margin="20,8,20,16" Spacing="{StaticResource SpaceS}"
     AllowDrop="True" DragOver="ComposerDragOver" Drop="ComposerDrop">
     <!-- 回复条：竖线 + 「回复 某人」+ 原文一行，右边关闭。 -->
     <Grid x:Name="ReplyBar" Visibility="Collapsed" ColumnSpacing="8" Padding="10,6,4,6" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border CornerRadius="1.5" Background="{ThemeResource AccentFillColorDefaultBrush}"/>
      <StackPanel Grid.Column="1" Spacing="1">
       <TextBlock x:Name="ReplyLabel" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
       <TextBlock x:Name="ReplyPreview" Style="{StaticResource SecondaryCaptionTextBlockStyle}" TextWrapping="NoWrap"/>
      </StackPanel>
      <Button x:Name="CancelReply" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="28" Height="28" FontSize="12" Content="&#xE711;" Click="ClearReply" ToolTipService.ToolTip="取消回复" AutomationProperties.Name="取消回复"/>
     </Grid>
     <!-- 待发送的附件：点发送才上传（同 iOS），可以逐个移除。 -->
     <ScrollViewer x:Name="AttachmentStrip" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
      <StackPanel x:Name="AttachmentItems" Orientation="Horizontal" Spacing="{StaticResource SpaceS}" Padding="0,0,0,4"/>
     </ScrollViewer>
     <Grid ColumnSpacing="{StaticResource SpaceXS}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="2">
       <DropDownButton x:Name="AttachButton" Style="{StaticResource ComposerDropDownStyle}" ToolTipService.ToolTip="添加附件" AutomationProperties.Name="添加附件">
        <FontIcon Glyph="&#xE710;" FontSize="16"/>
        <DropDownButton.Flyout>
         <MenuFlyout Placement="TopEdgeAlignedLeft">
          <MenuFlyoutItem Text="图片或视频…" Click="AttachMediaClicked"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
          <MenuFlyoutItem Text="文件…" Click="AttachFileClicked"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
          <MenuFlyoutItem Text="录制语音" Click="RecordVoiceClicked"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE720;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
         </MenuFlyout>
        </DropDownButton.Flyout>
       </DropDownButton>
       <Button x:Name="FaceButton" Style="{StaticResource IconButtonStyle}" Content="&#xE76E;" Click="ChooseFace" ToolTipService.ToolTip="表情" AutomationProperties.Name="表情"/>
       <Button x:Name="MentionButton" Style="{StaticResource IconButtonStyle}" FontFamily="{ThemeResource ContentControlThemeFontFamily}" FontWeight="SemiBold" Content="@" Click="ChooseMention" Visibility="Collapsed" ToolTipService.ToolTip="提及群成员" AutomationProperties.Name="提及群成员"/>
      </StackPanel>
      <TextBox x:Name="Composer" Grid.Column="1" PlaceholderText="输入消息" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160" MinHeight="36"
       BeforeTextChanging="ComposerBeforeTextChanging" TextChanged="DraftChanged" KeyDown="ComposerKeyDown" Paste="ComposerPaste" AutomationProperties.Name="消息输入框"/>
      <Button x:Name="SendButton" Grid.Column="2" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Bottom" Height="36" Padding="12,0" Click="SendClicked"
       ToolTipService.ToolTip="发送（Enter）· 换行（Shift+Enter）" AutomationProperties.Name="发送">
       <FontIcon Glyph="&#xE724;" FontSize="16"/>
      </Button>
     </Grid>
    </StackPanel>
    <!-- 多选时代替输入区：已选条数 + 转发 / 合并转发 / 取消。 -->
    <Grid x:Name="SelectionBar" Grid.Row="2" Visibility="Collapsed" Margin="20,8,20,16" Padding="12,6" ColumnSpacing="8" CornerRadius="{ThemeResource OverlayCornerRadius}"
     Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="SelectionCount" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}"/>
     <Button x:Name="SelectionForward" Grid.Column="1" Click="ForwardSelectedClicked" Tag="single"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72D;" FontSize="14"/><TextBlock Text="逐条转发"/></StackPanel></Button>
     <Button x:Name="SelectionBundle" Grid.Column="2" Click="ForwardSelectedClicked" Tag="bundle" Style="{ThemeResource AccentButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8F1;" FontSize="14"/><TextBlock Text="合并转发"/></StackPanel></Button>
     <Button Grid.Column="3" Content="取消" Click="CancelSelectionClicked"/>
    </Grid>
   </Grid>
  </Grid>
  </NavigationView>
  </Grid>
  <ScrollViewer x:Name="Onboarding" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
   <Grid MinHeight="600" Padding="32,48">
    <StackPanel MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
     <Image Source="ms-appx:///Assets/AppIcon.png" Width="80" Height="80" HorizontalAlignment="Left"/>
     <TextBlock Text="BetterChat" FontSize="36" FontWeight="SemiBold"/>
     <TextBlock x:Name="OnboardingSubtitle" Text="在 Windows 上，继续你的 QQ 聊天。" TextWrapping="Wrap" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="24">
      <StackPanel x:Name="OnboardingContent" Spacing="{StaticResource SpaceL}"/>
     </Border>
    </StackPanel>
   </Grid>
  </ScrollViewer>
  <TitleBar x:Name="AppTitleBar" Title="BetterChat" Height="58" BackRequested="TitleBarBackRequested" PaneToggleRequested="TitleBarPaneToggleRequested">
   <TitleBar.Resources>
    <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
    <x:Double x:Key="TitleBarIconMaxWidth">32</x:Double><x:Double x:Key="TitleBarIconMaxHeight">32</x:Double>
    <x:Double x:Key="TitleBarLeftPaddingWidth">24</x:Double>
    <Thickness x:Key="TitleBarIconMargin">0,0,24,0</Thickness>
   </TitleBar.Resources>
   <TitleBar.IconSource><BitmapIconSource UriSource="ms-appx:///Assets/AppIcon.png" ShowAsMonochrome="False"/></TitleBar.IconSource>
   <TitleBar.Content>
    <AutoSuggestBox x:Name="Search" Visibility="Collapsed" MinWidth="180" MaxWidth="580" HorizontalAlignment="Stretch" PlaceholderText="搜索消息、联系人和群聊" QueryIcon="Find" QuerySubmitted="SearchSubmitted" VerticalAlignment="Center" AutomationProperties.Name="全局搜索"/>
   </TitleBar.Content>
  </TitleBar>
  <!-- 看图 / 看视频：盖住标题栏以下的整个窗口，固定深色（Smoke 画刷在浅色主题下太透，背后的聊天会透出来，2026-10-17 实测）。滚轮 / 双击缩放，左右键切换同一会话的图片和视频，Esc 关闭。 -->
  <Grid x:Name="Viewer" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Background="#E6101010" RequestedTheme="Dark"
   IsTabStop="True" KeyDown="ViewerKeyDown" AutomationProperties.Name="媒体查看器">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Padding="16,8" ColumnSpacing="8" Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Spacing="1">
     <TextBlock x:Name="ViewerTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
     <TextBlock x:Name="ViewerSubtitle" Style="{StaticResource SecondaryCaptionTextBlockStyle}"/>
    </StackPanel>
    <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent" IsDynamicOverflowEnabled="True" VerticalAlignment="Center">
     <AppBarButton x:Name="ViewerZoomIn" Icon="ZoomIn" Label="放大" LabelPosition="Collapsed" Click="ViewerZoomClicked" Tag="in" ToolTipService.ToolTip="放大（Ctrl+滚轮）"/>
     <AppBarButton x:Name="ViewerZoomOut" Icon="ZoomOut" Label="缩小" LabelPosition="Collapsed" Click="ViewerZoomClicked" Tag="out" ToolTipService.ToolTip="缩小"/>
     <AppBarButton x:Name="ViewerCopy" Icon="Copy" Label="复制" Click="ViewerCopyClicked"/>
     <AppBarButton Icon="Save" Label="另存为" Click="ViewerSaveClicked"/>
     <AppBarButton Icon="Forward" Label="转发" Click="ViewerForwardClicked"/>
     <CommandBar.SecondaryCommands>
      <AppBarButton Icon="OpenWith" Label="用系统程序打开" Click="ViewerOpenClicked"/>
     </CommandBar.SecondaryCommands>
    </CommandBar>
   </Grid>
   <Grid Grid.Row="1">
    <ScrollViewer x:Name="ViewerScroll" ZoomMode="Enabled" MinZoomFactor="0.25" MaxZoomFactor="8" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
     HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled" DoubleTapped="ViewerDoubleTapped">
     <Image x:Name="ViewerImage" Stretch="Uniform"/>
    </ScrollViewer>
    <MediaPlayerElement x:Name="ViewerPlayer" Visibility="Collapsed" AreTransportControlsEnabled="True" AutoPlay="True" Margin="48,24"/>
    <ProgressRing x:Name="ViewerLoading" IsActive="False" Width="40" Height="40"/>
    <TextBlock x:Name="ViewerError" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center"/>
    <Button x:Name="ViewerPrevious" Style="{StaticResource FloatingButtonStyle}" HorizontalAlignment="Left" Margin="24,0" Click="ViewerStepClicked" Tag="-1" ToolTipService.ToolTip="上一张（←）" AutomationProperties.Name="上一张"><FontIcon Glyph="&#xE76B;" FontSize="16"/></Button>
    <Button x:Name="ViewerNext" Style="{StaticResource FloatingButtonStyle}" HorizontalAlignment="Right" Margin="24,0" Click="ViewerStepClicked" Tag="1" ToolTipService.ToolTip="下一张（→）" AutomationProperties.Name="下一张"><FontIcon Glyph="&#xE76C;" FontSize="16"/></Button>
    <Button Style="{StaticResource FloatingButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,24,0" Click="ViewerCloseClicked" ToolTipService.ToolTip="关闭（Esc）" AutomationProperties.Name="关闭查看器"><FontIcon Glyph="&#xE711;" FontSize="14"/></Button>
   </Grid>
  </Grid>
  <InfoBar x:Name="Notice" Grid.Row="2" IsOpen="False" IsClosable="True" Severity="Error" Margin="12,0,12,8"/>
 </Grid>
</Window>
