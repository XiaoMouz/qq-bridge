<Window x:Class="BetterChat.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:BetterChat" Title="BetterChat">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.Resources>
   <DataTemplate x:Key="FaceTemplate" x:DataType="local:FaceEntry">
    <Grid Width="44" Height="44" ToolTipService.ToolTip="{x:Bind Name}" AutomationProperties.Name="{x:Bind Name}">
     <Image Source="{x:Bind ImagePath}" Width="30" Height="30" Stretch="Uniform"/>
    </Grid>
   </DataTemplate>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="Workspace" Grid.Row="1" Visibility="Collapsed">
  <!-- 外壳：Fluent 的左侧紧凑导航。返回键和展开导航的按钮都放在 TitleBar 上，NavigationView 自己的隐藏。 -->
  <NavigationView x:Name="Nav" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
   IsSettingsVisible="False" IsTitleBarAutoPaddingEnabled="False" OpenPaneLength="240" SelectionChanged="NavChanged"
   PaneOpening="NavPaneOpening" PaneClosing="NavPaneClosing" AutomationProperties.Name="主导航">
   <NavigationView.MenuItems>
    <NavigationViewItem x:Name="MessagesNavItem" Tag="messages" Content="消息" ToolTipService.ToolTip="消息">
     <NavigationViewItem.Icon><FontIcon Glyph="&#xE8BD;"/></NavigationViewItem.Icon>
     <NavigationViewItem.InfoBadge><InfoBadge x:Name="UnreadBadge" Visibility="Collapsed"/></NavigationViewItem.InfoBadge>
    </NavigationViewItem>
    <NavigationViewItem x:Name="ContactsNavItem" Tag="contacts" Content="联系人" ToolTipService.ToolTip="联系人">
     <NavigationViewItem.Icon><FontIcon Glyph="&#xE716;"/></NavigationViewItem.Icon>
    </NavigationViewItem>
   </NavigationView.MenuItems>
   <NavigationView.PaneFooter>
    <!-- 账号头像不是导航目的地，点了直接进「设置 → 连接与账号」。紧凑时宽 40 加左边距 4，和 48 宽的紧凑栏图标对齐；展开导航时显示昵称。 -->
    <Button x:Name="AccountButton" Visibility="Collapsed" Click="AccountClicked" MinWidth="40" Height="40" Margin="4,0,4,4" Padding="6,0"
     HorizontalAlignment="Left" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" AutomationProperties.Name="当前账号">
     <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceM}">
      <PersonPicture x:Name="AccountAvatar" Width="28" Height="28"/>
      <TextBlock x:Name="AccountName" Text="{x:Bind AccountAvatar.DisplayName, Mode=OneWay}" Visibility="Collapsed" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
     </StackPanel>
    </Button>
   </NavigationView.PaneFooter>
   <NavigationView.FooterMenuItems>
    <NavigationViewItem x:Name="SettingsNavItem" Tag="settings" Content="设置" ToolTipService.ToolTip="设置">
     <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon>
    </NavigationViewItem>
   </NavigationView.FooterMenuItems>
  <Grid x:Name="PaneHost">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="ListColumn" Width="320" MinWidth="{StaticResource ListPaneMinWidth}" MaxWidth="{StaticResource ListPaneMaxWidth}"/><ColumnDefinition x:Name="DetailColumn" Width="*"/></Grid.ColumnDefinitions>
   <Grid x:Name="ListPane" Padding="{StaticResource ListPanePadding}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="SectionTitle" Text="消息" Style="{StaticResource PageTitleTextBlockStyle}" Margin="8,0,0,8"/>
    <SelectorBar x:Name="Filter" Grid.Row="1" SelectionChanged="FilterChanged" Margin="0,0,0,8" AutomationProperties.Name="列表筛选"/>
    <ListView x:Name="Items" Grid.Row="2" SelectionChanged="ItemSelected" IsItemClickEnabled="False" SelectionMode="Single" HorizontalContentAlignment="Stretch" AutomationProperties.Name="项目列表">
     <ListView.ItemTemplate><DataTemplate x:DataType="local:ListEntry">
      <!-- 会话行和 iOS DialogRow 对齐：头像｜名称 + 置顶 / 免打扰 + 时间｜[草稿] 发送者：预览 + @ / 回复 / 全体 + 未读数。 -->
      <Grid Padding="0,10" ColumnSpacing="{StaticResource SpaceM}" Background="Transparent" ContextRequested="ListRowContextRequested" AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
       <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <PersonPicture DisplayName="{x:Bind Title, Mode=OneWay}" Width="40" Height="40" Visibility="{x:Bind HasAvatar, Mode=OneWay}" Loaded="AvatarLoaded" Unloaded="AvatarUnloaded" DataContextChanged="AvatarContextChanged"/>
       <Border Width="40" Height="40" CornerRadius="{ThemeResource OverlayCornerRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="{x:Bind HasGlyph, Mode=OneWay}">
        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="18"/>
       </Border>
       <Grid Grid.Column="1" RowSpacing="2" VerticalAlignment="Center">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpaceXS}" Margin="8,0,0,0" VerticalAlignment="Center">
         <FontIcon Glyph="&#xE718;" Style="{StaticResource RowStateIconStyle}" Visibility="{x:Bind Pinned, Mode=OneWay}" ToolTipService.ToolTip="已置顶"/>
         <FontIcon Glyph="&#xE7ED;" Style="{StaticResource RowStateIconStyle}" Visibility="{x:Bind Muted, Mode=OneWay}" ToolTipService.ToolTip="免打扰"/>
         <TextBlock Text="{x:Bind Caption, Mode=OneWay}" Style="{StaticResource SecondaryCaptionTextBlockStyle}"/>
        </StackPanel>
        <TextBlock Grid.Row="1" Style="{StaticResource SecondaryCaptionTextBlockStyle}" TextWrapping="NoWrap" Visibility="{x:Bind HasSubtitle, Mode=OneWay}">
         <Run Text="{x:Bind DraftPrefix, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/><Run Text="{x:Bind SenderPrefix, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/><Run Text="{x:Bind Subtitle, Mode=OneWay}"/>
        </TextBlock>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpaceXS}" Margin="8,0,0,0">
         <Border Style="{StaticResource RowMarkStyle}" Background="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind Mention, Mode=OneWay}" ToolTipService.ToolTip="有人@我"><TextBlock Text="@" Style="{StaticResource RowMarkTextStyle}"/></Border>
         <Border Style="{StaticResource RowMarkStyle}" Background="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind Reply, Mode=OneWay}" ToolTipService.ToolTip="有人回复我"><FontIcon Glyph="&#xE97A;" FontSize="9" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/></Border>
         <Border Style="{StaticResource RowMarkStyle}" Background="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind MentionAll, Mode=OneWay}" ToolTipService.ToolTip="@全体成员"><TextBlock Text="全" Style="{StaticResource RowMarkTextStyle}"/></Border>
         <Border Style="{StaticResource UnreadPillStyle}" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind AccentUnread, Mode=OneWay}"><TextBlock Text="{x:Bind Unread, Mode=OneWay}" Style="{StaticResource RowMarkTextStyle}"/></Border>
         <Border Style="{StaticResource UnreadPillStyle}" Background="{ThemeResource ControlStrongFillColorDefaultBrush}" Visibility="{x:Bind MutedUnread, Mode=OneWay}"><TextBlock Text="{x:Bind Unread, Mode=OneWay}" Style="{StaticResource RowMarkTextStyle}"/></Border>
        </StackPanel>
       </Grid>
      </Grid>
     </DataTemplate></ListView.ItemTemplate>
    </ListView>
    <Button x:Name="MoreSearchResults" Grid.Row="3" Content="加载更多搜索结果" Visibility="Collapsed" HorizontalAlignment="Stretch" Margin="4,8" Click="LoadSearchMore"/>
   </Grid>
   <!-- 拖动调整列表宽度；双击恢复默认。压在列表右边线上，左右各露 4 像素。 -->
   <local:PaneSplitter x:Name="ListSplitter" HorizontalAlignment="Right" Width="8" Margin="0,0,-4,0" Canvas.ZIndex="1"
    ManipulationMode="TranslateX" ManipulationDelta="ListSplitterDelta" ManipulationCompleted="ListSplitterCompleted" DoubleTapped="ListSplitterReset"
    ToolTipService.ToolTip="拖动调整列表宽度，双击恢复默认" AutomationProperties.Name="调整列表宽度"/>
   <Grid x:Name="DetailPane" Grid.Column="1" Margin="{StaticResource DetailCardMargin}" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="{ThemeResource OverlayCornerRadius}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Padding="{StaticResource PageHeaderPadding}" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock x:Name="ContentTitle" Text="欢迎使用 BetterChat" Style="{StaticResource PageTitleTextBlockStyle}"/><TextBlock x:Name="ContentSubtitle" Text="你的 QQ 消息，在 Windows 上保持同步" Style="{StaticResource SecondaryCaptionTextBlockStyle}"/></StackPanel>
     <Button x:Name="ChatMore" Grid.Column="1" Content="&#xE712;" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center" Visibility="Collapsed" ToolTipService.ToolTip="会话选项" AutomationProperties.Name="会话选项" Click="ChatOptions"/>
    </Grid>
    <Grid Grid.Row="1">
     <ScrollViewer x:Name="DetailScroll" Padding="{StaticResource PagePadding}"><StackPanel x:Name="Details" Spacing="{StaticResource SpaceL}" MaxWidth="{StaticResource DetailContentMaxWidth}" HorizontalAlignment="Left"/></ScrollViewer>
     <Grid x:Name="ChatPanel" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <!-- 滚到顶部 / 底部附近自动加载上一页 / 下一页，加载时只显示一条细进度条。 -->
      <ProgressBar x:Name="HistoryLoadingBar" IsIndeterminate="True" Visibility="Collapsed" Margin="20,4,20,0"/>
      <InfoBar x:Name="ChatLoadNotice" Grid.Row="1" Severity="Warning" IsClosable="True" Margin="20,0,20,8">
       <InfoBar.ActionButton><Button Content="重试" Click="RetryChatLoad"/></InfoBar.ActionButton>
      </InfoBar>
      <ListView x:Name="Messages" Grid.Row="2" SelectionMode="None" HorizontalContentAlignment="Stretch" Padding="20,10" AutomationProperties.Name="聊天消息" ContainerContentChanging="MessageContainerChanging">
       <ListView.ItemTemplate><DataTemplate x:DataType="local:TimelineEntry"><ContentControl HorizontalContentAlignment="Stretch" IsTabStop="False" SizeChanged="MessageSizeChanged"/></DataTemplate></ListView.ItemTemplate>
       <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView"/></ItemsPanelTemplate></ListView.ItemsPanel>
      </ListView>
      <StackPanel x:Name="ChatState" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Spacing="12" Margin="24" Visibility="Collapsed">
       <ProgressRing x:Name="ChatLoading" Width="32" Height="32" IsActive="False"/>
       <TextBlock x:Name="ChatStateTitle" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       <TextBlock x:Name="ChatStateDescription" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <Button x:Name="ChatRetry" Content="重新加载" Click="RetryChatLoad" HorizontalAlignment="Center"/>
      </StackPanel>
      <!-- 浮动按钮：右下角，「@」在上、「回到最新」在下。 -->
      <StackPanel Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,16" Spacing="{StaticResource SpaceS}">
       <Grid>
        <Button x:Name="MentionJumpButton" Style="{StaticResource FloatingButtonStyle}" Visibility="Collapsed" Click="MentionJumpClicked"
         ToolTipService.ToolTip="有人@我或回复我" AutomationProperties.Name="查看 @我 和回复我的消息">
         <TextBlock Text="@" FontWeight="SemiBold" FontSize="16"/>
        </Button>
        <InfoBadge x:Name="MentionJumpBadge" Style="{ThemeResource CriticalValueInfoBadgeStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
         Visibility="{x:Bind MentionJumpButton.Visibility, Mode=OneWay}" IsHitTestVisible="False"/>
       </Grid>
       <Button x:Name="LatestButton" Style="{StaticResource FloatingButtonStyle}" Visibility="Collapsed" Click="ReturnToLatest"
        ToolTipService.ToolTip="回到最新" AutomationProperties.Name="回到最新">
        <FontIcon Glyph="&#xE74B;" FontSize="16"/>
       </Button>
      </StackPanel>
     </Grid>
    </Grid>
    <StackPanel x:Name="ComposerPanel" Grid.Row="2" Visibility="Collapsed" Margin="20,8,20,18" Spacing="8">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ReplyLabel" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/><Button Grid.Column="1" x:Name="CancelReply" Content="取消回复" Visibility="Collapsed" Click="ClearReply"/></Grid>
     <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="4">
       <Button Content="&#xE723;" FontFamily="Segoe Fluent Icons" Click="AttachFile" AutomationProperties.Name="添加附件"/>
       <Button x:Name="FaceButton" Content="&#xE899;" FontFamily="Segoe Fluent Icons" Click="ChooseFace" AutomationProperties.Name="选择 QQ 表情"/>
       <Button x:Name="MentionButton" Content="@" Click="ChooseMention" Visibility="Collapsed" AutomationProperties.Name="提及群成员"/>
      </StackPanel>
      <TextBox x:Name="Composer" Grid.Column="1" PlaceholderText="输入消息…" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160" MinHeight="42" BeforeTextChanging="ComposerBeforeTextChanging" TextChanged="DraftChanged" KeyDown="ComposerKeyDown" AutomationProperties.Name="消息输入框"/>
      <Button x:Name="SendButton" Grid.Column="2" Content="发送" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Bottom" Click="SendClicked"/>
     </Grid>
     <TextBlock Text="Enter 发送 · Shift + Enter 换行" Style="{StaticResource TertiaryCaptionTextBlockStyle}"/>
    </StackPanel>
   </Grid>
  </Grid>
  </NavigationView>
  </Grid>
  <ScrollViewer x:Name="Onboarding" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
   <Grid MinHeight="600" Padding="32,48">
    <StackPanel MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
     <Image Source="ms-appx:///Assets/AppIcon.png" Width="80" Height="80" HorizontalAlignment="Left"/>
     <TextBlock Text="BetterChat" FontSize="36" FontWeight="SemiBold"/>
     <TextBlock x:Name="OnboardingSubtitle" Text="在 Windows 上，继续你的 QQ 聊天。" TextWrapping="Wrap" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <StackPanel x:Name="OnboardingContent" Spacing="16"/>
    </StackPanel>
   </Grid>
  </ScrollViewer>
  <TitleBar x:Name="AppTitleBar" Title="BetterChat" Height="58" BackRequested="TitleBarBackRequested" PaneToggleRequested="TitleBarPaneToggleRequested">
   <TitleBar.Resources>
    <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
    <x:Double x:Key="TitleBarIconMaxWidth">32</x:Double><x:Double x:Key="TitleBarIconMaxHeight">32</x:Double>
    <x:Double x:Key="TitleBarLeftPaddingWidth">24</x:Double>
    <Thickness x:Key="TitleBarIconMargin">0,0,24,0</Thickness>
   </TitleBar.Resources>
   <TitleBar.IconSource><BitmapIconSource UriSource="ms-appx:///Assets/AppIcon.png" ShowAsMonochrome="False"/></TitleBar.IconSource>
   <TitleBar.Content>
    <AutoSuggestBox x:Name="Search" Visibility="Collapsed" MinWidth="180" MaxWidth="580" HorizontalAlignment="Stretch" PlaceholderText="搜索消息、联系人和群聊" QueryIcon="Find" QuerySubmitted="SearchSubmitted" VerticalAlignment="Center" AutomationProperties.Name="全局搜索"/>
   </TitleBar.Content>
  </TitleBar>
  <InfoBar x:Name="Notice" Grid.Row="2" IsOpen="False" IsClosable="True" Severity="Error" Margin="12,0,12,8"/>
 </Grid>
</Window>
