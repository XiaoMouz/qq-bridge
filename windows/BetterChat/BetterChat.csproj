<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>BetterChat</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- 不打 MSIX 也要开：否则 dotnet publish 不带 BetterChat.pri 和 .xbf，装好的程序一启动就 XAML 解析失败（2026-10-19 实测）。 -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 发布时 CI 用标签里的版本覆盖（win-v1.2.0 → -p:Version=1.2.0）；Velopack 要三段式 SemVer。 -->
    <Version>1.0.0</Version>
    <!-- exe、安装程序和快捷方式的图标：Assets/make-icon.ps1 按矢量逐个尺寸画（16–256），改样子改脚本再跑一遍。 -->
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
    <!-- 入口在 Program.cs：先处理 Velopack 的安装 / 更新钩子再启动 WinUI。 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <!-- 更新源地址由发布流水线传入（-p:UpdateUrl=…/betterchat/windows/x64）；本机构建没有它，就不检查更新。 -->
  <ItemGroup Condition="'$(UpdateUrl)' != ''">
    <AssemblyMetadata Include="UpdateUrl" Value="$(UpdateUrl)" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../ios/QQBridge/Resources/QQFaces/s*.png" Link="Assets/QQFaces/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Assets/FaceCatalog.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 标题栏、引导页、关于页用 AppLogo.png；任务栏和 Alt+Tab 用 AppIcon.ico（AppWindow.SetIcon）。 -->
    <Content Update="Assets/AppLogo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Assets/AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Remove="Assets/make-icon.ps1" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <ProjectReference Include="../BetterChat.Core/BetterChat.Core.csproj" />
  </ItemGroup>
</Project>

