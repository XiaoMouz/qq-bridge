<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      设计数值：间距按 4 的倍数；字体只用 Fluent 自带的 Caption / Body / BodyStrong / Subtitle / Title 样式；
      颜色只引用主题画刷（深浅色、高对比度由系统切换），不写死色值。新界面引用这里的键，不再在代码里写数字。
    -->
    <x:Double x:Key="SpaceXS">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">12</x:Double>
    <x:Double x:Key="SpaceL">16</x:Double>
    <x:Double x:Key="SpaceXL">24</x:Double>
    <x:Double x:Key="SpaceXXL">32</x:Double>

    <!-- 中栏列表的可拖动范围（P1 接上拖动；默认宽 320 写在 ColumnDefinition 上，GridLength 不能引用 x:Double）。 -->
    <x:Double x:Key="ListPaneMinWidth">260</x:Double>
    <x:Double x:Key="ListPaneMaxWidth">420</x:Double>
    <!-- 右栏阅读内容的最大宽度：设置、资料这类页面靠左排，超过这个宽度不再拉宽（2026-10-17 实测宽窗口居中会在左边空出一大块）。 -->
    <x:Double x:Key="DetailContentMaxWidth">800</x:Double>

    <!-- 设置 / 资料页的卡片间距和分组标题，取 Windows 设置和 WinUI Gallery 的数值：卡片之间 4，分组标题上 30 下 6。 -->
    <x:Double x:Key="SettingsCardSpacing">4</x:Double>
    <Thickness x:Key="SettingsSectionHeaderMargin">1,26,0,2</Thickness>
    <!-- 右栏标题行固定按「标题 + 一行副标题」的高度：没有副标题时标题居中，正在输入等提示出现时标题行不跳。 -->
    <x:Double x:Key="PageHeaderMinHeight">78</x:Double>

    <Thickness x:Key="PagePadding">28,24,28,24</Thickness>
    <Thickness x:Key="PageHeaderPadding">24,16,16,16</Thickness>
    <Thickness x:Key="ListPanePadding">12,16,12,8</Thickness>
    <Thickness x:Key="DetailCardMargin">8,8,12,12</Thickness>
    <!-- 会话资料栏：和聊天卡片并排，左边不再留边距（聊天卡片右边已有 12）。 -->
    <Thickness x:Key="InfoCardMargin">0,8,12,12</Thickness>
    <Thickness x:Key="InfoPanePadding">16,16,16,24</Thickness>

    <Style x:Key="PageTitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <Style x:Key="SecondaryCaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="TertiaryCaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
    </Style>

    <!-- 会话行：置顶 / 免打扰的小图标，@ / 回复 / 全体的圆点，未读数胶囊（同 InfoBadge 的尺寸，但能显示 99+）。 -->
    <Style x:Key="RowStateIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
    </Style>
    <Style x:Key="RowMarkStyle" TargetType="Border">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="CornerRadius" Value="9"/>
    </Style>
    <Style x:Key="UnreadPillStyle" TargetType="Border">
        <Setter Property="MinWidth" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="5,0"/>
    </Style>
    <Style x:Key="RowMarkTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextLineBounds" Value="Tight"/>
        <!-- Tight 在 18 像素的胶囊里取整后字形偏下约 1 像素（2026-10-17 放大截图实测：上 6 下 4），用底边距往上抬回中间。 -->
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <!-- 聊天页右下角的圆形浮动按钮（回到最新、@我）。 -->
    <Style x:Key="FloatingButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
    </Style>

    <!-- 聊天气泡：自己的用强调色，别人的用卡片底色加描边；引用块、卡片在气泡里再套一层浅底。 -->
    <x:Double x:Key="BubbleMaxWidth">560</x:Double>
    <Thickness x:Key="BubblePadding">12,8,12,6</Thickness>
    <Style x:Key="BubbleTimeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Opacity" Value="0.7"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style x:Key="NoticeBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="24,6"/>
    </Style>

    <!-- 输入区左侧的附件下拉按钮，和旁边的图标按钮同高、透明底。 -->
    <Style x:Key="ComposerDropDownStyle" TargetType="DropDownButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="8,0,4,0"/>
    </Style>
    <!-- 输入区上方的附件卡片。 -->
    <Style x:Key="AttachmentChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}"/>
        <Setter Property="Padding" Value="6"/>
    </Style>

    <!-- 只有图标的工具按钮（会话选项等），和 CommandBar 里的按钮同尺寸。 -->
    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>
</ResourceDictionary>
