<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      设计数值：间距按 4 的倍数；字体只用 Fluent 自带的 Caption / Body / BodyStrong / Subtitle / Title 样式；
      颜色只引用主题画刷（深浅色、高对比度由系统切换），不写死色值。新界面引用这里的键，不再在代码里写数字。
    -->
    <x:Double x:Key="SpaceXS">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">12</x:Double>
    <x:Double x:Key="SpaceL">16</x:Double>
    <x:Double x:Key="SpaceXL">24</x:Double>
    <x:Double x:Key="SpaceXXL">32</x:Double>

    <!-- 中栏列表的可拖动范围（P1 接上拖动；默认宽 320 写在 ColumnDefinition 上，GridLength 不能引用 x:Double）。 -->
    <x:Double x:Key="ListPaneMinWidth">260</x:Double>
    <x:Double x:Key="ListPaneMaxWidth">420</x:Double>
    <!-- 右栏阅读内容的最大宽度：设置、资料这类页面靠左排，超过这个宽度不再拉宽（2026-10-17 实测宽窗口居中会在左边空出一大块）。 -->
    <x:Double x:Key="DetailContentMaxWidth">800</x:Double>

    <Thickness x:Key="PagePadding">28,24,28,24</Thickness>
    <Thickness x:Key="PageHeaderPadding">24,16,16,16</Thickness>
    <Thickness x:Key="ListPanePadding">12,16,12,8</Thickness>
    <Thickness x:Key="DetailCardMargin">8,8,12,12</Thickness>

    <Style x:Key="PageTitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <Style x:Key="SecondaryCaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="TertiaryCaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
    </Style>

    <!-- 只有图标的工具按钮（会话选项等），和 CommandBar 里的按钮同尺寸。 -->
    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>
</ResourceDictionary>
