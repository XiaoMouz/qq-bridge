# 复制为 deploy/.env 后按需修改（.env 不入库）。

# 让容器里的 napcat 用户与本机用户一致，挂载目录的文件权限才正常。
# 在本机执行 id -u / id -g 获取（macOS 一般是 501 / 20）。
NAPCAT_UID=501
NAPCAT_GID=20

# 测试用 QQ 小号（开发期一律用小号）。留空则每次都要扫码。
QQ_ACCOUNT=

# NapCat WebUI 的登录口令（首次启动时写入，之后改需要删掉 data/napcat-config/webui.json）。
NAPCAT_WEBUI_TOKEN=

# 通话桥总开关（默认 0）：打开后插件接管通话引擎并启动 AV Host。做通话验证时再设为 1。
QQBRIDGE_CALLS=0

# P0-C（G1）研究开关：来电自动接听，验证双向音频用。生产必须为 0。
QQBRIDGE_CALL_AUTO_ACCEPT=0

# G2 指令重放：开放向通话引擎发送任意指令的接口。
QQBRIDGE_LAB=0

# 通话引擎事件采样时，保留取值（敏感键仍会打码）；默认只记结构。
QQBRIDGE_CAPTURE_AVSDK_VALUES=0

# 插件开发模式：用挂载的 dist 覆盖镜像内的插件（还需在 compose 里取消对应挂载的注释）。
QQBRIDGE_PLUGIN_DEV=0

# ===== 服务端（packages/server，本机运行时由 pnpm cli 读取本文件）=====
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://qqbridge:change-me@127.0.0.1:5432/qqbridge
HOST=127.0.0.1
PORT=8080
# 媒体内容寻址存储目录（相对 packages/server）
MEDIA_ROOT=../../deploy/data/media
# 媒体签名链接密钥：至少 32 字节，可用 openssl rand -hex 32 生成
MEDIA_URL_SECRET=
LOG_LEVEL=info
# 媒体下载任务：同时下载数（0 = 不启动），以及没有配置存储策略时的自动下载上限（字节，默认 200MB）
MEDIA_FETCH_CONCURRENCY=3
MEDIA_AUTO_FETCH_MAX_BYTES=209715200

# 消息上游：NapCat 插件连服务端的口令（至少 32 字节，可用 openssl rand -hex 32 生成）。
# QQ 容器与服务端读的是同一个值；QQ 号归属的服务端账号只有一个时 UPSTREAM_ACCOUNT 可留空。
UPSTREAM_TOKEN=
UPSTREAM_ACCOUNT=
# 对账：服务端没见过的会话预热多少条；回填请求的最小间隔（毫秒，防风控）。
UPSTREAM_WARM_MESSAGES=200
UPSTREAM_BACKFILL_INTERVAL_MS=1000
# 发送媒体时 NapCat 从这里下载（QQ 容器视角）；默认 http://host.internal:<PORT>。
# UPSTREAM_MEDIA_BASE_URL=http://host.internal:8080
# 冷存储根目录（外接大硬盘等）：不常用的原件下沉到这里；不设置则不分层。
# 目录里要有 .qqbridge-storage 标记文件才算挂上（盘拔掉时服务端不会往系统盘上写）：
#   sudo mkdir -p /Volumes/HDD-1/qqbridge-cold && sudo chown "$(whoami)":staff /Volumes/HDD-1/qqbridge-cold && touch /Volumes/HDD-1/qqbridge-cold/.qqbridge-storage
# MEDIA_COLD_ROOT=/Volumes/HDD-1/qqbridge-cold
# NapCat WebUI 地址（扫码登录中转用；口令就是上面的 NAPCAT_WEBUI_TOKEN）。
# NAPCAT_WEBUI_URL=http://127.0.0.1:6099
# 单个上传的大小上限（字节，默认 1GB）。
# UPLOAD_MAX_BYTES=1073741824

# ===== 通话（LiveKit）=====
LIVEKIT_API_KEY=qqbridge
# 至少 32 字节，可用 openssl rand -hex 32 生成
LIVEKIT_API_SECRET=
# 节点 IP：iPhone 能访问到的这台机器的地址（阶段 A 建议用这台 Mac 的 Tailscale IP）
LIVEKIT_NODE_IP=127.0.0.1
# LiveKit 媒体端口（7881/tcp、7882/udp）绑定的地址。OrbStack / Docker Desktop 上只能是 0.0.0.0 或 127.0.0.1（引擎在虚拟机里），
# 要让 iPhone 直连就得用 0.0.0.0；Linux 主机上可以设成 Tailscale IP，只对 tailnet 开放。信令端口 7880 固定只开在回环上。
LIVEKIT_BIND_IP=127.0.0.1
# 客户端连 LiveKit 的地址（经 tailscale serve 的 HTTPS，见 README"通话"一节）。
# LIVEKIT_PUBLIC_URL=wss://<mac>.<tailnet>.ts.net:7443
# 通话网关控制接口的口令（至少 32 字节，可用 openssl rand -hex 32 生成）；服务端与网关容器共用。
CALL_GATEWAY_TOKEN=
# 开放 /lab/call 通话测试页（iOS 客户端完成前代替 iPhone 接听）。
# CALL_LAB=1

# ===== 推送（APNs）=====
# Developer 网站 → Keys 新建一个勾选 APNs 的 Key，下载的 .p8 放到 deploy/data/（不进 git），三项都配了才推送。
# 路径相对 packages/server（服务端的工作目录），写绝对路径最稳。
# APNS_KEY_PATH=../../deploy/data/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=XXXXXXXXXX
# APNS_TOPIC=com.xiaomouz.betterchat
# macOS 独立应用的 topic（设备登录时标记为 macos）：
# APNS_MACOS_TOPIC=com.xiaomouz.betterchat.mac
# 0：通知里不写消息内容，只写"新消息"（内容不经过 Apple）。
# APNS_PREVIEW=1
