{
  "name": "@qqbridge/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "客户端协议（Protobuf / ConnectRPC）。proto 是唯一真相源，TS 代码由 buf 生成到 src/gen",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "buf lint && buf generate",
    "typecheck": "tsc -p tsconfig.json",
    "generate:swift": "buf generate --template buf.gen.swift.yaml"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "typescript": "^5.9.0"
  }
}
