    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "livekit-server-sdk": "^2.19.1",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "sharp": "^0.35.5",
    "silk-wasm": "^3.7.1",
    "thumbhash": "^0.1.1",
    "ws": "^8",
    "zod": "^4.6.5"
